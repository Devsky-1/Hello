<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing rounded frame container -->
    <path
        android:pathData="M32,26 H76 A10,10 0 0 1 86,36 V72 A10,10 0 0 1 76,82 H32 A10,10 0 0 1 22,72 V36 A10,10 0 0 1 32,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="22"
                android:startY="26"
                android:endX="86"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#26FFFFFF" />
                <item android:offset="1.0" android:color="#0DFFFFFF" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="22"
                android:startY="26"
                android:endX="86"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00F0FF" />
                <item android:offset="0.5" android:color="#FF8A2BE2" />
                <item android:offset="1.0" android:color="#FFFF007F" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeWidth">
            <string android:value="2.5" />
        </aapt:attr>
    </path>

    <!-- Glowing celestial sun/orb -->
    <path android:pathData="M63,42m-8,0a8,8 0 1,1 16,0a8,8 0 1,1 -16,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="55"
                android:startY="34"
                android:endX="71"
                android:endY="50"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFE600" />
                <item android:offset="1.0" android:color="#FFFF3366" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Geometric landscape back mountain -->
    <path android:pathData="M30,76 L48,50 L64,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="50"
                android:endX="64"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF6C5CE7" />
                <item android:offset="1.0" android:color="#FF1E1547" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Geometric landscape front mountain -->
    <path android:pathData="M44,76 L60,54 L78,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44"
                android:startY="54"
                android:endX="78"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00D2FF" />
                <item android:offset="1.0" android:color="#FF3A7BD5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sparkle accent top left -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M27,24 L28,29 L33,30 L28,31 L27,36 L26,31 L21,30 L26,29 Z" />

    <!-- Sparkle accent bottom right -->
    <path
        android:fillColor="#FFFF3388"
        android:pathData="M81,73 L82,76 L85,77 L82,78 L81,81 L80,78 L77,77 L80,76 Z" />
</vector>
